# Botty bootstrap config. Copy to .env and fill in. Everything else (Modules,
# Karakeep, channels) is configured in the dashboard and stored in SQLite.

# --- Discord ---------------------------------------------------------------
# Developer Portal (https://discord.com/developers/applications) -> your app:
#   1. Bot -> Reset Token, paste it here.
#   2. Bot -> Privileged Gateway Intents -> turn on MESSAGE CONTENT INTENT
#      (needed to read links in messages).
#   3. Invite the bot with the `bot` scope and permissions integer 66624
#      (View Channels, Read Message History, Add Reactions):
#      https://discord.com/oauth2/authorize?client_id=<APPLICATION_ID>&scope=bot&permissions=66624
DISCORD_TOKEN=replace-with-your-bot-token

# --- Dashboard sign-in (Pocket ID over OIDC) --------------------------------
# In Pocket ID -> OIDC Clients -> Add:
#   - Confidential client (leave "Public client" off); copy the secret, it is shown once.
#   - Callback URL:        ${PUBLIC_URL}/auth/callback   e.g. https://botty.example.com/auth/callback
#   - Logout Callback URL: ${PUBLIC_URL}/                e.g. https://botty.example.com/
#   - Access tab: "Selected user groups" -> tick only the Admin group below.
# The issuer is Pocket ID's APP_URL. It must also be reachable from inside the
# container (token/userinfo/JWKS calls go server to server).
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
# The Pocket ID group *name* (not its friendly name) whose members are Admins.
ADMIN_GROUP=botty_admins

# Signs the dashboard session cookie. At least 32 characters; generate with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# The public origin of the dashboard, served at the root of its own host
# (no sub-path). TLS is terminated by your reverse proxy.
PUBLIC_URL=https://botty.example.com

# --- Optional ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# HTTP port; compose.yaml publishes the same port on the host.
PORT=3000
# Where botty.db lives; compose mounts ./data here.
DATA_DIR=/data

# Development only: extra hostnames the Vite dev server (npm run dev:client)
# accepts, comma-separated, e.g. a Tailscale name. Unused in production.
# DEV_ALLOWED_HOSTS=
