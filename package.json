{
  "name": "botty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "dev:client": "vite"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
